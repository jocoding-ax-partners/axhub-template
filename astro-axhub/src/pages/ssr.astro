---
import Layout from "../layouts/Layout.astro";
import { isAxhubConfigured, me } from "../lib/axhub-server";

// 방문자 신원 원본 — axhub 문(ingress 게이트)이 이 요청에 실어 준 X-AxHub-* 헤더와 me() 가 해석한 결과.
// 로컬 dev 엔 문이 없어 전부 빈 값(익명)이에요. 값은 문이 매 요청 덮어쓰므로 위조할 수 없어요.
const HEADER_NAMES = [
  "x-axhub-user-id",
  "x-axhub-user-email",
  "x-axhub-user-name",
  "x-axhub-app-role",
  "x-axhub-is-admin",
  "x-axhub-tenant-slug",
  "x-axhub-surface",
];
const rawHeaders = Object.fromEntries(HEADER_NAMES.map((n) => [n, Astro.request.headers.get(n) ?? ""]));
const visitor = await me(Astro.request);

const ts = new Date().toISOString();
---

<Layout title="SSR 데모 — axhub × Astro">
  <main>
    <h1>SSR 데모</h1>
    <p>
      이 페이지는 매 요청마다 서버에서 렌더돼요. 시간:
      <code>{ts}</code>
    </p>

    {!isAxhubConfigured() && (
      <div class="warn-card">
        axhub 환경변수가 설정되지 않았어요. <code>.env</code> 또는 axhub 배포 환경을 확인해 주세요. (로컬은 문이 없어 아래가 전부 익명이에요)
      </div>
    )}

    <section class="result">
      <h2>me(Astro.request) 결과</h2>
      <pre>{JSON.stringify(visitor, null, 2)}</pre>
    </section>

    <section class="result">
      <h2>문이 실어 준 X-AxHub-* 헤더 원본</h2>
      <p>email / name 은 base64(UTF-8) — <code>me()</code> 가 디코드해요. 빈 값 = 익명(정상).</p>
      <pre>{JSON.stringify(rawHeaders, null, 2)}</pre>
    </section>

    <p><a href="/">← 홈으로</a></p>
  </main>
</Layout>

<style>
  main {
    max-width: 720px;
    margin: 4rem auto;
    padding: 0 1rem;
  }
  .warn-card {
    margin: 1rem 0;
    padding: 1rem;
    background: #fffbeb;
    border: 1px solid #fde68a;
    border-radius: 0.5rem;
    color: #92400e;
  }
  .result pre {
    background: #f3f4f6;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    font-size: 0.85rem;
  }
</style>

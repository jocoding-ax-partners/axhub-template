---
import Layout from "../layouts/Layout.astro";
import { isAxhubConfigured, me } from "../lib/axhub-server";

// 방문자 신원 원본 — axhub 문(ingress 게이트)이 이 요청에 실어 준 X-AxHub-* 헤더와
// me() 가 해석한 결과. 로컬 dev 엔 문이 없어 전부 빈 값(익명)이에요.
// 값은 문이 매 요청 덮어쓰므로 클라이언트가 위조할 수 없어요.
const HEADER_NAMES = [
  "x-axhub-user-id",
  "x-axhub-user-email",
  "x-axhub-user-name",
  "x-axhub-app-role",
  "x-axhub-is-admin",
  "x-axhub-tenant-slug",
  "x-axhub-surface",
];
const rawHeaders = Object.fromEntries(HEADER_NAMES.map((n) => [n, Astro.request.headers.get(n) ?? ""]));
const visitor = await me(Astro.request);
const ts = new Date().toISOString();
---

<Layout title="SSR 데모 — axhub × Astro">
  <div class="ax-stack">
    <div class="ax-page-header">
      <div>
        <h1 class="ax-page-title">SSR 데모</h1>
        <p class="ax-page-desc">이 페이지는 매 요청마다 서버에서 렌더돼요.</p>
      </div>
      <a class="ax-btn ax-btn-ghost" href="/">홈으로</a>
    </div>

    {
      !isAxhubConfigured() && (
        <section class="ax-card">
          <h2 class="ax-card-title">로컬 실행 중</h2>
          <p class="ax-card-desc">
            문(게이트)이 없어 아래 헤더가 전부 비어 있어요. axhub 로 배포하면 값이 채워져요.
          </p>
        </section>
      )
    }

    <section class="ax-card">
      <h2 class="ax-card-title">me(Astro.request) 결과</h2>
      <p class="ax-card-desc">헬퍼가 해석한 값이에요. 렌더 시각 {ts}</p>
      <pre class="out">{JSON.stringify(visitor, null, 2)}</pre>
    </section>

    <section class="ax-card">
      <h2 class="ax-card-title">문이 실어 준 X-AxHub-* 헤더 원본</h2>
      <p class="ax-card-desc">
        email 과 name 은 base64(UTF-8) 예요. <code class="ax-tag">me()</code> 가 디코드해요. 빈 값은 익명이고 정상이에요.
      </p>
      <pre class="out">{JSON.stringify(rawHeaders, null, 2)}</pre>
    </section>
  </div>
</Layout>

<style>
  /* 이 페이지에서만 쓰는 배치. 색·크기는 토큰(var(--...))만 씁니다. */
  .out {
    margin: 20px 0 0;
    padding: 16px;
    border-radius: var(--radius-control);
    background: var(--bg-muted);
    color: var(--fg-secondary);
    font-size: var(--text-caption);
    line-height: 1.7;
    overflow-x: auto;
  }
</style>

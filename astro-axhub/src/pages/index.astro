---
import Layout from "../layouts/Layout.astro";
import { APP_NAME, isAxhubConfigured, me } from "../lib/axhub-server";
import { isDbConfigured } from "../lib/db";

// 방문자 신원 — axhub 문이 요청마다 실어 주는 헤더를 읽어요 (허브 호출 없음).
const configured = isAxhubConfigured();
const visitor = await me(Astro.request);
const dbReady = isDbConfigured();

const title = visitor.authenticated ? `환영합니다, ${visitor.name || visitor.email}님 👋` : "환영합니다 👋";
const desc = !configured
  ? "로컬에서 실행 중이에요. axhub 로 배포하면 로그인한 사용자가 여기 표시돼요."
  : visitor.authenticated
    ? `${APP_NAME} 이 준비됐어요. 이제 화면만 만들면 돼요.`
    : "오른쪽 위에서 로그인하면 이름이 여기 표시돼요.";

const rows: [string, string][] = [
  ["이름", visitor.name || "—"],
  ["이메일", visitor.email || "—"],
  ["워크스페이스", visitor.tenant_slug || "—"],
  ["이 앱에서의 역할", visitor.app_role || "—"],
  ["관리자", visitor.is_admin ? "예" : "아니오"],
];

const DB_ON = `import { db, ensureSchema } from "../lib/db";

await ensureSchema();
await db()\`INSERT INTO todos (user_key, title) VALUES (\${userKey}, \${title})\`;`;

const DB_OFF = `database:
  engine: postgres`;

/* ─────────────────────────────────────────────────────────────────────────────
 * 🤖 Claude Code / AI 에이전트 — 이 앱 만드는 법 (지우지 말 것)
 *
 * 【디자인】 색·크기는 항상 토큰으로. #hex 나 font-size: 14px 같은 생값 금지.
 *   - 배경은 회색(surface), 내용은 흰 카드(.ax-card) 안에. 이게 axhub 의 기본 모양이다.
 *   - 페이지 = <div class="ax-stack"> 안에 .ax-page-header + 섹션들.
 *   - 바깥 여백·최대 폭은 셸(.ax-container)이 이미 잡았다. 페이지가 또 붙이지 않는다.
 *   - 쓸 수 있는 조각: .ax-card .ax-card-title .ax-card-desc .ax-section-title
 *     .ax-btn(.ax-btn-primary/.ax-btn-ghost/.ax-btn-sm) .ax-input .ax-tag .ax-dot .ax-check
 *     .ax-code .ax-empty .ax-grid(.ax-grid-3) .ax-muted .ax-subtle .ax-small .ax-caption .ax-done
 *   - 페이지 안에서만 쓰는 스타일이 필요하면 <style> 에 쓰되 값은 var(--토큰) 으로.
 *   - 전체 규칙은 src/styles/tokens.css 주석 참고. 그 파일은 자동 생성이라 고치지 않는다.
 *
 * 【레이아웃】 새 화면을 추가할 때
 *   - src/layouts/Layout.astro 는 건드리지 않는다. 내용만 <Layout> 안에 넣는다.
 *   - 사이드바 메뉴는 src/config/navigation.ts 배열에 한 줄 추가한다.
 *
 * 【백엔드】 전부 서버(frontmatter / src/pages/api/*.ts)에서 호출한다.
 *
 * 1) 지금 방문자가 누구인지
 *    import { me, loginUrl, logoutUrl } from "../lib/axhub-server";
 *    const visitor = await me(Astro.request);
 *    // { authenticated, user_id, email, name, app_role, is_admin, tenant_slug, surface }
 *    // authenticated=false 는 오류가 아니라 "로그인 안 됨" 정상 상태 — 로그인 버튼을 보여준다.
 *    // 출처는 axhub 문이 요청마다 실어 주는 X-AxHub-* 헤더 (허브 API 를 다시 부르지 않는다 —
 *    // 퍼블릭·커스텀 도메인에선 허브 쿠키가 없어 sdk.identity.me 는 401 이다).
 *    // 헤더 원본을 직접 보고 싶으면 Astro.request.headers 를 그대로 찍어 보면 된다.
 *    // "/__axhub/auth/*" 는 플랫폼 예약 경로 — 앱 라우트로 쓰지 않는다.
 *
 * 2) 데이터 저장·조회 · 표준 PostgreSQL
 *    ⚠️ 기본으로는 DB 가 없다. axhub.yaml 의 database 선언 주석을 풀고
 *    다시 배포해야 발급된다. 로컬은 `npm run db:up`.
 *    import { db, ensureSchema } from "../lib/db";
 *    await ensureSchema();                       // 첫 read/write 전에 한 번
 *    await db()`INSERT INTO todos (user_key, title) VALUES (${userKey}, ${title})`;
 *    // 새 테이블이 필요하면 src/lib/db.ts 의 ensureSchema() 에 CREATE TABLE IF NOT EXISTS 를 추가.
 *    // 폼 쓰기는 frontmatter 에서 POST → formData → db() → Astro.redirect("/").
 *    // 사용자별로 가르려면 visitor.email(또는 user_id)을 user_key 컬럼으로 쓰고 늘 필터한다.
 * ───────────────────────────────────────────────────────────────────────────── */
---

<Layout title="axhub × Astro">
  {/* 페이지 내용은 .ax-stack 으로 세로로 쌓아요. 바깥 여백은 셸이 이미 잡아 놨어요. */}
  <div class="ax-stack">
    <div class="ax-page-header">
      <div>
        <h1 class="ax-page-title">{title}</h1>
        <p class="ax-page-desc">{desc}</p>
      </div>
      <a class="ax-btn ax-btn-ghost" href="https://docs.axhub.ai/ko/docs" target="_blank" rel="noreferrer">
        가이드 보기
      </a>
    </div>

    {/* 신원 데모 — 실제 앱에선 지우고 원하는 내용을 넣으세요. */}
    <section class="ax-card">
      <h2 class="ax-card-title">내 정보</h2>
      <p class="ax-card-desc">
        axhub 문이 요청마다 실어 주는 <code class="ax-tag">X-AxHub-*</code> 헤더를 읽은 결과예요. 허브에 다시 묻지 않아요.
      </p>

      <div class="visitor">
        {
          !configured ? (
            <p class="ax-muted ax-small">로컬에는 문(게이트)이 없어서 값이 비어 있어요. 배포하면 채워져요.</p>
          ) : (
            <dl class="rows">
              <div class="row">
                <dt class="ax-caption ax-subtle">상태</dt>
                <dd class="ax-small">
                  <span class:list={["ax-dot", visitor.authenticated ? "ax-dot-ok" : "ax-dot-idle"]} />
                  {visitor.authenticated ? "로그인함" : "로그인 안 함 (정상)"}
                </dd>
              </div>
              {rows.map(([label, value]) => (
                <div class="row">
                  <dt class="ax-caption ax-subtle">{label}</dt>
                  <dd class="ax-small">{value}</dd>
                </div>
              ))}
            </dl>
          )
        }
      </div>
    </section>

    <section>
      <h2 class="ax-section-title">시작 안내</h2>

      {/* 데이터베이스는 기본으로 붙지 않아요 — 필요할 때 켜는 방식이에요. */}
      <div class="ax-card">
        <h3 class="ax-card-title">데이터베이스 연결하기</h3>
        {
          dbReady ? (
            <Fragment>
              <p class="ax-card-desc">
                연결돼 있어요. <code class="ax-tag">src/lib/db.ts</code> 로 바로 쿼리하면 돼요.
              </p>
              <code class="ax-code">{DB_ON}</code>
            </Fragment>
          ) : (
            <Fragment>
              <p class="ax-card-desc">
                이 앱은 아직 데이터베이스가 없어요. 필요하면 <code class="ax-tag">axhub.yaml</code> 에서 아래 두 줄의
                주석을 풀고 다시 배포하세요. 전용 PostgreSQL 이 발급되고 접속 정보가 자동으로 들어와요.
              </p>
              <code class="ax-code">{DB_OFF}</code>
              <p class="ax-small ax-muted hint">
                로컬에서 먼저 해 보려면 <code class="ax-tag">npm run db:up</code> 으로 Postgres 를 띄우고
                <code class="ax-tag">.env</code> 에 DATABASE_URL 을 채우세요. 쓰는 법은
                <code class="ax-tag">src/lib/db.ts</code> 에 적혀 있어요.
              </p>
            </Fragment>
          )
        }
      </div>

      <div class="ax-grid guides">
        <div class="ax-card">
          <h3 class="ax-card-title">화면 만들기</h3>
          <p class="ax-caption ax-subtle guide-code">src/pages/index.astro</p>
          <p class="ax-small ax-muted guide-desc">
            이 페이지를 고치거나 새 화면을 추가하세요. 사이드바 메뉴는 src/config/navigation.ts 에 한 줄 더하면 돼요.
          </p>
        </div>
        <div class="ax-card">
          <h3 class="ax-card-title">배포하기</h3>
          <p class="ax-caption ax-subtle guide-code">/axhub:deploy</p>
          <p class="ax-small ax-muted guide-desc">
            Claude Code 에서 한 줄로 배포해요. 배포 전에 디자인 규칙 검사가 자동으로 돌아요.
          </p>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  /* 이 페이지에서만 쓰는 배치. 색·크기는 토큰(var(--...))만 씁니다. */
  .visitor {
    margin-top: 20px;
  }
  .rows {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px 24px;
    margin: 0;
  }
  @media (min-width: 640px) {
    .rows {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border-default);
  }
  .row dd {
    margin: 0;
    text-align: right;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hint {
    margin: 16px 0 0;
  }
  .guides {
    margin-top: 16px;
  }
  @media (min-width: 640px) {
    .guides {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .guide-code {
    margin: 4px 0 0;
    font-family: var(--font-mono);
  }
  .guide-desc {
    margin: 12px 0 0;
  }
</style>

# 로컬에서 돌릴 때 쓰는 값이에요. `npm run setup` 이 이 파일을 .env.local 로 복사해요.
# axhub 에 배포하면 DB·로그인 값은 axhub 가 알아서 넣어 줘요 — 배포용으로 여기 채울 필요 없어요.

# ── 데이터베이스 (기본은 꺼져 있어요) ─────────────────────────────────────────
# DB 가 필요할 때만 켜요. 순서는 README 의 "DB 켜기" 를 보세요.
#   로컬: Docker Desktop 실행 → `npm run db:up` → 아래 DATABASE_URL 주석 해제 → `npm run dev` 재시작
#   배포: axhub.yaml 의 `database:` 두 줄 주석 해제 → 다시 배포 (DATABASE_URL 은 axhub 가 자동으로 넣어 줘요)
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/app
# DIRECT_DATABASE_URL 은 스키마 초기화/마이그레이션용 — 비워두면 DATABASE_URL 로 폴백돼요.
# DIRECT_DATABASE_URL=

# ── axhub 연결 (로그인 · connector) ───────────────────────────────────────────
# 로컬에서는 비워 두세요 — 비어 있으면 앱이 "로컬 실행 중" 으로 동작해요 (로그인 버튼 없음).
# 배포하면 axhub 가 자동으로 넣어 줘요. 방문자 신원은 axhub 문이 요청마다 실어 주는 X-AxHub-* 헤더로 알아요.
# APPHUB_API_URL=https://api.axhub.ai
# APPHUB_APP_SLUG=my-app-slug
# APPHUB_TENANT=my-tenant

# ── AI (Claude) ──────────────────────────────────────────────────────────────
# ① 기본 — Anthropic 키: https://console.anthropic.com/settings/keys 에서 발급한 sk-ant-… 를 넣어요.
# ② 선택 — 회사 AXRouter: `axhub axrouter keys issue --name "내 챗봇"` 으로 받은 ax-… 를 넣고
#          아래 ANTHROPIC_BASE_URL 주석을 풀어요. 사용량·한도는 회사 콘솔에서 관리돼요.
# 절대 커밋하지 마세요. 배포한 앱에는 `axhub env set ANTHROPIC_API_KEY --secret --from-stdin` 으로 넣어요.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://axrouter.ai
# 쓸 모델. 비워두면 claude-sonnet-5-5. 더 깊게 생각해야 하면 claude-opus-5-5, 더 싸고 빠르게는 claude-haiku-4-5.
# AI_MODEL=

{
  "name": "chatbot-axhub",
  "version": "0.1.0",
  "private": true,
  "description": "axhub 위에서 바로 굴러가는 AI 챗봇 템플릿 (Next.js 16 + Claude)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "setup": "node -e \"const fs=require('fs');if(fs.existsSync('.env.local')){console.log('.env.local 이 이미 있어요')}else{fs.copyFileSync('.env.example','.env.local');console.log('.env.local 을 만들었어요')}\"",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d",
    "db:psql": "docker compose -f docker-compose.dev.yml exec db psql -U postgres -d app",
    "check:design": "bash scripts/check-design.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@ax-hub/sdk": "^6.3.0",
    "next": "^16.0.10",
    "postgres": "^3.4.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}

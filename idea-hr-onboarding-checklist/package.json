{
  "name": "idea-hr-onboarding-checklist",
  "version": "0.1.0",
  "private": true,
  "description": "신규 입사자 온보딩 체크리스트 앱 — axhub 로그인 + axhub DB · Tailwind 4 + HeroUI v3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "setup": "node -e \"const fs=require('fs');if(fs.existsSync('.env.local')){console.log('.env.local 이 이미 있어요')}else{fs.copyFileSync('.env.example','.env.local');console.log('.env.local 을 만들었어요')}\"",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && docker compose -f docker-compose.dev.yml up -d",
    "db:psql": "docker compose -f docker-compose.dev.yml exec db psql -U postgres -d app",
    "check:design": "bash scripts/check-design.sh",
    "check:logic": "node --experimental-strip-types --no-warnings scripts/onboarding-check.mjs"
  },
  "dependencies": {
    "@ax-hub/sdk": "^6.3.0",
    "postgres": "^3.4.5",
    "next": "^16.0.10",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@jocoding-ax-partners/design-system": "^4.2.0",
    "@jocoding-ax-partners/react": "^2.1.1",
    "@phosphor-icons/react": "^2.1.10"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.0",
    "eslint": "^9",
    "eslint-config-next": "^16.2.4",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.3.0"
  }
}
